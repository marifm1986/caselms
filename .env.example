# Copy to .env.local and fill in. Never commit real values.
# All NEXT_PUBLIC_* values are safe to expose to the browser (Firebase web config,
# EmailJS public key, Cloudinary unsigned preset). Security is enforced by
# firestore.rules, not by hiding these keys.

NEXT_PUBLIC_SITE_URL=https://www.caselms.com

# Firebase (Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# EmailJS (Account > API keys, Email Services, Email Templates)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudinary (Settings > Upload > Upload presets, signing mode "Unsigned")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
