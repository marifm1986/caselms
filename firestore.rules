rules_version = '2';

// Case LMS Firestore security rules.
// Admins are users with a document at admins/{uid}. Create the first one by
// hand in the Firebase console (see README). Nobody can grant themselves admin
// except by claiming a pending invite created by an existing admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // Legacy admin docs (first bootstrap) may have no `role` field; treat as owner.
    function myRole() {
      return myAdminDoc().get('role', 'owner');
    }

    function myScopes() {
      return myAdminDoc().get('scopes', ['content', 'messages', 'settings', 'users']);
    }

    function canManageUsers() {
      return isAdmin() && (myRole() == 'owner' || ('users' in myScopes()));
    }

    function hasScope(scope) {
      return isAdmin() && (myRole() == 'owner' || (scope in myScopes()));
    }

    function isPublished() {
      return resource.data.published == true;
    }

    // Admin membership. Signed-in users may read their own entry; admins who
    // can manage users may create, update or delete other admins. The invite
    // path lets a newly signed-in user claim a matching invite without any
    // existing admin writing on their behalf.
    match /admins/{uid} {
      function invite() {
        return get(/databases/$(database)/documents/adminInvites/$(request.auth.token.email.lower())).data;
      }
      function hasPendingInvite() {
        return request.auth.token.email != null
          && exists(/databases/$(database)/documents/adminInvites/$(request.auth.token.email.lower()));
      }
      function matchesInvite() {
        return request.resource.data.role == invite().role
          && request.resource.data.scopes == invite().scopes
          && request.resource.data.email == request.auth.token.email.lower();
      }
      function validShape() {
        return request.resource.data.keys().hasOnly(['email', 'role', 'scopes', 'createdAt', 'createdBy'])
          && request.resource.data.role in ['owner', 'admin', 'editor']
          && request.resource.data.scopes is list
          && request.resource.data.email is string;
      }

      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      allow create: if request.auth != null && validShape() && (
        (request.auth.uid == uid && hasPendingInvite() && matchesInvite()
          && request.resource.data.role != 'owner')
        || (canManageUsers() && request.resource.data.role != 'owner')
      );

      allow update: if canManageUsers() && validShape()
        && resource.data.get('role', 'owner') != 'owner'
        && request.resource.data.role != 'owner';

      allow delete: if canManageUsers()
        && resource.data.get('role', 'owner') != 'owner'
        && request.auth.uid != uid;
    }

    // Pending admin invites keyed by lowercased email. Only user-managers may
    // create them; the invited user can read and delete their own invite.
    match /adminInvites/{inviteId} {
      function isOwnInvite() {
        return request.auth != null && request.auth.token.email != null
          && inviteId == request.auth.token.email.lower();
      }
      function validInviteShape() {
        return request.resource.data.keys().hasOnly(['email', 'role', 'scopes', 'createdAt', 'createdBy'])
          && request.resource.data.role in ['admin', 'editor']
          && request.resource.data.scopes is list
          && request.resource.data.email == inviteId;
      }
      allow read: if canManageUsers() || isOwnInvite();
      allow create, update: if canManageUsers() && validInviteShape();
      allow delete: if canManageUsers() || isOwnInvite();
    }

    // Site-wide settings, including contact details. Public read.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content collections. The public sees published items only; the site
    // queries with `published == true` so these rules are satisfied.
    match /{collection}/{docId} {
      function isContent() {
        return collection in ['features', 'plans', 'testimonials', 'faqs', 'team', 'posts'];
      }
      allow read: if isContent() && (isPublished() || isAdmin());
      allow write: if isContent() && isAdmin();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form submissions: anyone may create a well-formed message,
    // only admins may read, update (mark read) or delete.
    match /messages/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'firm', 'phone', 'topic', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
        && request.resource.data.firm is string && request.resource.data.firm.size() <= 160
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 40
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
